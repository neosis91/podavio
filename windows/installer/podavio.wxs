<?xml version="1.0" encoding="utf-8"?>
<!--
  Un seul fichier .msi. Le programme installé reste un dossier : Windows charge
  les bibliothèques à côté de podavio.exe.
  UpgradeCode est stable : le changer ferait de la mise à jour un second logiciel.
  ProductVersion est AAAA%100.M.N, parce que le numéro majeur d’un MSI ne dépasse pas 255.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Podavio"
      Manufacturer="Podavio"
      Version="$(var.ProductVersion)"
      UpgradeCode="6f2a9c14-8d37-4b5e-a1c0-3e7b9d2f48a6"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Podavio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Podavio">
          <Files Include="$(var.SourceDir)\**">
            <Exclude Files="$(var.SourceDir)\**\*.pdb" />
          </Files>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PodavioMenu" Name="Podavio">
        <Component Id="PodavioStartMenu" Guid="a91c4e70-2b58-4f63-9d14-7c0e5a8b3d21">
          <Shortcut
              Id="PodavioShortcut"
              Name="Podavio"
              Target="[INSTALLFOLDER]podavio.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="PodavioMenuFolder" Directory="PodavioMenu" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\Podavio"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
