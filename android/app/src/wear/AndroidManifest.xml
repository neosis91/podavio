<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".wear.PodavioWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/podavio"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <provider
            android:name=".wear.WearBridgeProvider"
            android:authorities="${applicationId}.wearbridge"
            android:exported="false" />
    </application>
</manifest>
